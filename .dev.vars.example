# Copy to .dev.vars for `npm run preview:pages`. These are Cloudflare's published
# Turnstile test keys (always pass); never put production keys in this file.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Logs the message instead of sending it. Remove and set RESEND_API_KEY to send for real.
CONTACT_DRY_RUN=1
