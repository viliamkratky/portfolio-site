---
interface Props {
  caption?: string;
  wide?: boolean;
  /** Tall captures scroll inside a fixed-height frame. */
  scroll?: boolean;
}
const { caption, wide = false, scroll = false } = Astro.props;
---

<figure class:list={['not-prose my-16', wide && 'lg:-mr-[calc((100%_-_144px)/7_+_24px)]']}>
  <div class="relative overflow-hidden rounded-xl bg-surface">
    <div
      class:list={[
        '[&_img]:block [&_img]:h-auto [&_img]:w-full',
        scroll && 'max-h-[min(72vh,760px)] overflow-y-auto overscroll-contain [scrollbar-width:thin]',
      ]}
      tabindex={scroll ? 0 : undefined}
      aria-label={scroll ? 'Scrollable capture' : undefined}
      role={scroll ? 'region' : undefined}
      data-lenis-prevent={scroll ? '' : undefined}
    >
      <slot />
    </div>
    {scroll && <span class="t-meta pointer-events-none absolute right-4 bottom-4 rounded-full bg-fg px-3 py-1.5 text-bg">Scroll inside ↓</span>}
  </div>
  {caption && <figcaption class="mt-4 max-w-[60ch] text-[14px] text-fg-3">{caption}</figcaption>}
</figure>
