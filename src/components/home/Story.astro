---
/**
 * Scrollytelling: what I do, told in two beats. A halftone field
 * grows from the bottom and turns the page from light to dark between them.
 */
const first = ['From', 'an', 'unclear', 'problem.'];
const second = ['To', 'a', 'working', 'system.'];
---

<!--
  Pinned scenes are position: fixed, so the section must cover the large viewport
  (mobile browser bars collapsed); otherwise the page shows through below it. The
  bottom padding keeps the text centred in the small viewport, where it is always visible.
  The canvas also reaches above the section: iOS paints what lies above the viewport under
  the status bar, which would otherwise stay light while the scene turns dark. The field
  fills the top last, so the overhang is empty while it overlaps the hero (reduced motion
  draws it full from the start, so it gets no overhang).
-->
<section class="story relative grid h-lvh bg-bg place-items-center overflow-x-clip pb-[calc(100lvh-100svh)]" data-story aria-label="From an unclear problem to a working system.">
  <canvas class="pointer-events-none absolute inset-x-0 bottom-0 h-[calc(100%+6rem)] w-full motion-reduce:h-full" aria-hidden="true"></canvas>
  <p class="s1 t-mega container-page absolute text-center" aria-hidden="true">
    {first.map((w) => <><span class="mask"><span class="word">{w}</span></span>{' '}</>)}
  </p>
  <p class="s2 t-mega container-page absolute text-center text-bg" aria-hidden="true">
    {second.map((w) => <><span class="mask"><span class="word">{w}</span></span>{' '}</>)}
  </p>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .s1 {
      display: none;
    }
  }
</style>
