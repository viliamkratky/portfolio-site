---
/**
 * Contact dialog, opened by any [data-contact-open] trigger (the "Let's talk" CTA).
 * JS only: without JS the trigger stays a mailto: link and the email stays visible.
 * Logic in src/interactive/contact.ts, server side in functions/api/contact.ts.
 */
import { site } from '../../config/site';
import { CONTACT_LIMITS, HONEYPOT } from '../../lib/contact';
import { contactFormEnabled, turnstileSiteKey } from '../../lib/turnstile';

// Focus is ink, not the site-wide accent ring: in a form, red reads as an error, so red is kept for errors only.
const input =
  'w-full rounded-md border border-fg-3 bg-bg px-3.5 py-3 text-[16px] text-fg transition-[border-color,box-shadow] duration-(--dur-1) placeholder:text-fg-3 hover:border-fg focus-visible:border-fg focus-visible:ring-1 focus-visible:ring-fg focus-visible:outline-hidden aria-[invalid=true]:border-accent-ink aria-[invalid=true]:focus-visible:ring-accent-ink';
const label = 't-meta text-fg-3';
const error = 'text-[14px] text-accent-ink';
---

{contactFormEnabled && (
  <dialog
    id="contact-dialog"
    class="contact-dialog m-0 h-dvh max-h-none w-screen max-w-none overflow-y-auto overscroll-contain bg-bg p-0 text-fg md:m-auto md:h-fit md:max-h-[calc(100dvh-48px)] md:w-[min(600px,calc(100vw-48px))] md:rounded-xl md:border md:border-line-2 md:bg-elevated"
    aria-labelledby="contact-title"
    data-sitekey={turnstileSiteKey}
    data-lenis-prevent
  >
    <div class="flex min-h-full flex-col px-(--gutter) pb-8 md:px-10 md:pb-10">
      <div class="flex h-(--header-h) shrink-0 items-center justify-between md:h-auto md:pt-9">
        <h2 id="contact-title" class="t-h3">
          Let’s talk
        </h2>
        <button type="button" data-close class="-mx-3 px-3 py-3 text-[14px]">
          <span class="roll">
            <span>Close</span>
            <span aria-hidden="true">Close</span>
          </span>
        </button>
      </div>

      <form data-contact-form novalidate class="mt-6 flex flex-1 flex-col gap-5 md:mt-8">
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="contact-name" class={label}>
              Name
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              maxlength={CONTACT_LIMITS.name}
              aria-describedby="contact-name-error"
              class={input}
            />
            <p id="contact-name-error" data-error-for="name" class={error} hidden />
          </div>
          <div class="flex flex-col gap-2">
            <label for="contact-email" class={label}>
              Email
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              required
              maxlength={CONTACT_LIMITS.email}
              aria-describedby="contact-email-error"
              class={input}
            />
            <p id="contact-email-error" data-error-for="email" class={error} hidden />
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <label for="contact-message" class={label}>
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            maxlength={CONTACT_LIMITS.message}
            aria-describedby="contact-message-hint contact-message-error"
            class:list={[input, 'min-h-36 resize-y']}
          />
          <p id="contact-message-hint" class="text-[14px] text-fg-3">
            Context, the problem, and what a good outcome looks like.
          </p>
          <p id="contact-message-error" data-error-for="message" class={error} hidden />
        </div>

        {/* Honeypot: off-screen and out of the tab order; only bots fill it. */}
        <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
          <label>
            Website <input type="text" name={HONEYPOT} tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div data-turnstile class="empty:hidden" />

        <p data-form-error role="alert" class="text-[15px] text-accent-ink" hidden>
          <span data-error-text />{' '}
          <a href={`mailto:${site.email}`} class="link-underline">
            {site.email}
          </a>
        </p>

        <div class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-4 pt-2">
          <p class="max-w-[36ch] text-[13px] text-fg-3">
            Used only to reply to you. Spam protection by Cloudflare Turnstile.
          </p>
          <button
            type="submit"
            class="inline-flex h-12 items-center gap-3 rounded-full bg-fg px-6 text-[15px] font-medium text-bg transition-colors duration-(--dur-2) hover:bg-accent hover:text-white disabled:pointer-events-none disabled:opacity-60"
          >
            <span data-submit-label>Send message</span>
            <span class="nudge" aria-hidden="true">
              →
            </span>
          </button>
        </div>
      </form>

      <div data-contact-sent tabindex="-1" class="flex flex-1 flex-col justify-center gap-4 py-12 outline-none" hidden>
        <p class="t-h2">Message sent.</p>
        <p class="t-lead text-fg-2">
          Thanks. I’ll reply to <span data-sent-email class="text-fg" />.
        </p>
        <div class="mt-4">
          <button
            type="button"
            data-close
            class="inline-flex h-12 items-center rounded-full border border-line-3 px-6 text-[15px] transition-colors duration-(--dur-2) hover:border-fg"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </dialog>
)}

<script>
  import '../../interactive/contact';
</script>
